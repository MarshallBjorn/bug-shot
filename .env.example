# BugShot local development defaults.
# Copy to .env for local use and change values as needed.
# Do not put real secrets or production data here.

COMPOSE_PROJECT_NAME=bugshot

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=bugshot_dev
POSTGRES_USER=bugshot
POSTGRES_PASSWORD=change-me-dev-only

BACKEND_PORT=8080
FRONTEND_PORT=5173

# Set this after the backend project exists, for example BugShot.Api.dll.
BACKEND_APP_DLL=BugShot.Api.dll

ASPNETCORE_ENVIRONMENT=Development
VITE_API_BASE_URL=http://localhost:8080

# Project the dashboard opens by default. Take the id from the projects table.
VITE_PROJECT_ID=

MINIO_ROOT_USER=bugshot-admin
MINIO_ROOT_PASSWORD=bugshot-admin-password-change-me

BACKUP_ACCESS_KEY_ID=bugshotbackup
BACKUP_SECRET_ACCESS_KEY=bugshotdevsecret1234567890abcd
BACKUP_AGE_PUBLIC_KEY=age1REPLACE_ME_WITH_PUBLIC_KEY

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PLACEHOLDER
