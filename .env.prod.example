# BugShot — PROD defaults.
# Kopiuj do `.env.prod` i uzupełnij PRAWDZIWYMI wartościami.
# NIE commitować `.env.prod` do repo. Sekrety trzymać w password managerze / secret store.
#
# Uruchamianie:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# UWAGA: prod override używa `${VAR:?...}` — brak którejś zmiennej = fail start.
# Ustaw WSZYSTKIE poniższe zanim odpalisz.

COMPOSE_PROJECT_NAME=bugshot

# ── Postgres ──────────────────────────────────────────────────────────
# Host i port NIE są używane w prod (postgres siedzi w db_internal, dostęp tylko z backend/backup).
# Zostawione żeby narzędzia migracji odpalane spoza compose miały spójne env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bugshot
POSTGRES_USER=bugshot
# Wygeneruj: `openssl rand -base64 32`
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Backend ────────────────────────────────────────────────────────────
BACKEND_APP_DLL=BugShot.Api.dll
ASPNETCORE_ENVIRONMENT=Production

# ── Frontend (Vite build-time) ────────────────────────────────────────
# Podstawiane przy budowie obrazu frontendu (`docker compose build frontend`).
# Muszą wskazywać na publiczne domeny za Cloudflare/Traefik.
VITE_API_BASE_URL=https://api.bugshot.app
VITE_MEDIA_BASE_URL=https://static.bugshot.app

# Signs dashboard access tokens. At least 32 bytes, the API refuses to start without it.
# Generate a real one per environment, for example: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-signing-key-change-me-at-least-32-bytes

# Konto administratora zakladane przez AdminSeeder przy starcie.
ADMIN_EMAIL=admin@bugshot.on-labs.dev
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# CORS — klucze czytane przez kod (Cors:DashboardOrigins / Cors:WidgetOrigins).
# Dashboard = origin SPA panelu:
Cors__DashboardOrigins__0=https://bugshot.on-labs.dev
# Widget osadza sie na domenach klientow — dopisz ich origins:
# Cors__WidgetOrigins__0=https://klient.example.com

# ── S3 zewnętrzny (dla backup) ────────────────────────────────────────
# Wybierz providera. Przykłady endpointów:
#   Backblaze B2:  https://s3.eu-central-003.backblazeb2.com   (region: eu-central-003)
#   Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com (region: auto)
#   Wasabi:        https://s3.eu-central-1.wasabisys.com        (region: eu-central-1)
#   AWS S3:        https://s3.eu-central-1.amazonaws.com        (region: eu-central-1)
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_BUCKET=bugshot-prod-backups
AWS_DEFAULT_REGION=eu-central-003

# Klucze do bucketu. Utwórz application key z uprawnieniami TYLKO do tego bucketu
# (nie master key). Backblaze: Application Keys → Add. R2: R2 → Manage API Tokens.
BACKUP_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY_ID
BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_ACCESS_KEY

# ── Szyfrowanie backupów (age) ────────────────────────────────────────
# Wygeneruj parę: `age-keygen -o backup-age.key` → public jest w pierwszej linii.
# Klucz PRYWATNY trzymasz w password managerze — potrzebny do RESTORE. NIE na VPS.
BACKUP_AGE_PUBLIC_KEY=age1REPLACE_WITH_PROD_PUBLIC_KEY

# ── Discord notifications (backup status) ─────────────────────────────
# Osobny webhook do prod, nie ten sam co dev.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_PROD_WEBHOOK

# ── Nie używane w prod (MinIO zdisabled przez profile) ────────────────
# Zostawione zakomentowane dla jasności. Nie odkomentuj — MinIO w prod nie startuje.
MINIO_ROOT_USER=1234
MINIO_ROOT_PASSWORD=1234

# ── Zmienne konsumowane przez OSOBNY compose Traefika (referencja) ────
# Nie są czytane przez ten compose, ale zostawione tu żeby jedno miejsce trzymało prod env.
# CF_DNS_API_TOKEN — token API Cloudflare z uprawnieniem Zone:DNS:Edit dla bugshot.app,
# używany przez cert-resolver DNS-01 Let's Encrypt.
# CF_DNS_API_TOKEN=REPLACE_WITH_CF_TOKEN
