+name: widget
+
+on:
+  push:
+    paths:
+      - 'widget/**'
+      - '.github/workflows/widget.yaml'
+      - 'Makefile'
+  pull_request:
+    branches: [main]
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  smoke:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24.x'
+
+      - name: Check JS syntax
+        run: |
+          for f in widget/*.js widget/vendor/*.js; do
+            [ -f "$f" ] && node --check "$f"
+          done
+
+      - name: Validate HTML
+        run: npx --yes html-validate widget/*.html
+
+  # Zastepuje dawne "detect" + "build-test" + "publish-npm". Package.json
+  # istnieje od tego momentu (poprzednio "detect" bylo martwym kodem — zawsze
+  # false), wiec ten job realnie sie odpala na kazdy PR/push do widget/**.
+  #
+  # NIE publikuje nigdzie (bez npm publish, bez NPM_TOKEN) — to job
+  # walidacyjny. Jedyna autoryzowana sciezka publikacji to release.yaml,
+  # ktory triguje sie WYLACZNIE z push do main.
+  build-validate:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: ./widget
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24.x'
+
+      - name: Build dist (walidacja pakowania, bez publikacji)
+        run: node scripts/build.mjs
+
+      - name: Verify npm package contents (dry-run, brak publikacji)
+        run: npm pack --dry-run
+
+      - name: Upload dist (do wgladu, nie do release — release.yaml buduje wlasny dist)
+        uses: actions/upload-artifact@v4
+        with:
+          name: widget-dist-${{ github.sha }}
+          path: widget/dist/
+          if-no-files-found: error
