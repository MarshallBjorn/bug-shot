# BugShot — DEV defaults.
# Copy to `.env` (or `.env.dev` if kompozycja pod to woła) i zmień co trzeba.
# NIE trzymać prawdziwych sekretów ani prod danych.
#
# Uruchamianie:
#   docker compose --env-file .env.dev up -d
# (base compose + override.yml, MinIO włączone przez profile `local-s3` jeśli tego wymaga stack)

COMPOSE_PROJECT_NAME=bugshot

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=bugshot_dev
POSTGRES_USER=bugshot
POSTGRES_PASSWORD=change-me-dev-only

# ── Porty exposed przez override.yml ──────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=5173
# nginx serwuje attachments + widgety. Trzymać z dala od BACKEND_PORT.
NGINX_PORT=8081

# ── Backend ────────────────────────────────────────────────────────────
BACKEND_APP_DLL=BugShot.Api.dll
ASPNETCORE_ENVIRONMENT=Development

# ── Frontend (Vite) ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
# Attachments idą z nginx, nie z API. Musi być zgodne z NGINX_PORT.
VITE_MEDIA_BASE_URL=http://localhost:8081
# Projekt otwierany domyślnie w dashboardzie. ID z tabeli `projects`.
VITE_PROJECT_ID=

# ── MinIO (lokalny S3, dev only) ──────────────────────────────────────
MINIO_ROOT_USER=bugshot-admin
MINIO_ROOT_PASSWORD=bugshot-admin-password-change-me

# ── Backup (dev — idzie do lokalnego MinIO) ───────────────────────────
# W dev backup używa endpointu z base compose (http://minio:9000). Nie override'ujemy.
BACKUP_ACCESS_KEY_ID=bugshotbackup
BACKUP_SECRET_ACCESS_KEY=bugshotdevsecret1234567890abcd
BACKUP_AGE_PUBLIC_KEY=age1REPLACE_ME_WITH_PUBLIC_KEY
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/PLACEHOLDER

# Zmienne używane tylko w prod override — w dev ignorowane, ale gdyby compose
# je przypadkiem widziało (bo jedziesz z oboma override'ami) — stuby żeby nie failowało:
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=bugshot-backups
AWS_DEFAULT_REGION=us-east-1
